{
  "name": "grand-exhibition-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "postinstall": "npm run setup:fonts",
    "setup:fonts": "node --use-env-proxy scripts/install-fonts.mjs",
